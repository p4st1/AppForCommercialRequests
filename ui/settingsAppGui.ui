<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>800</width>
    <height>600</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Настройки</string>
  </property>
  <property name="autoFillBackground">
   <bool>false</bool>
  </property>
  <property name="styleSheet">
   <string notr="true">QQMainWindow {
    background-color: #f5f7fa;
	font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ===== ЦЕНТРАЛЬНЫЙ ВИДЖЕТ ===== */
QWidget#centralWidget {
    background-color: #f5f7fa;
    padding: 15px;
}

/* ===== ТАБЛИЦА (Основной виджет) ===== */
QTableWidget {
    background-color: #ffffff;
    gridline-color: #dee2e6;
    border: 1px solid #dee2e6;
    border-radius: 10px;
    font-family: 'Inter';
    font-size: 12px;
    selection-background-color: #e3f2fd;
    selection-color: #1565c0;
    alternate-background-color: #f8f9fa;
    padding: 2px;
}

/* Заголовки столбцов таблицы */
QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 12px 15px;
    border: none;
    font-weight: 600;
    font-size: 13px;
    border-right: 1px solid #34495e;
    border-bottom: 2px solid #1a252f;
    text-align: left;
}

QHeaderView::section:first {
    border-top-left-radius: 9px;
    padding-left: 20px;
}

QHeaderView::section:last {
    border-top-right-radius: 9px;
    border-right: none;
}

/* Ячейки таблицы */
QTableWidget::item {
    padding: 10px 15px;
    border-bottom: 1px solid #f1f3f5;
}

/* Чередование строк таблицы */
QTableWidget::item:nth-child(even) {
    background-color: #f8f9fa;
}

QTableWidget::item:nth-child(odd) {
    background-color: #ffffff;
}

/* Выделенная строка */
QTableWidget::item:selected {
    background-color: #e3f2fd;
    color: #1565c0;
    font-weight: 500;
    border-left: 3px solid #2196f3;
}



/* Кнопки действий */
QPushButton#addButton {
    background-color: #27ae60;
}

QPushButton#addButton:hover {
    background-color: #2ecc71;
}

QPushButton#deleteButton {
    background-color: #e74c3c;
}

QPushButton#deleteButton:hover {
    background-color: #c0392b;
}

QPushButton#editButton {
    background-color: #3498db;
}

QPushButton#editButton:hover {
    background-color: #2980b9;
}

QPushButton#exportButton {
    background-color: #9b59b6;
}

QPushButton#exportButton:hover {
    background-color: #8e44ad;
}

/* ===== ПАНЕЛЬ ИНСТРУМЕНТОВ ===== */
QToolBar {
    background-color: #2c3e50;
    border: none;
    padding: 5px;
    spacing: 10px;
    border-bottom: 2px solid #1a252f;
}

QToolBar QToolButton {
    background-color: transparent;
    color: white;
    padding: 8px;
    border-radius: 4px;
}

QToolBar QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QToolBar QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

/* ===== СТАТУС БАР ===== */
QStatusBar {
    background-color: #2c3e50;
    color: white;
    font-size: 11px;
    padding: 8px 15px;
    border-top: 1px solid #34495e;
}

QStatusBar QLabel {
    color: white;
    padding: 0 10px;
}

/* ===== МЕНЮ БАР ===== */
QMenuBar {
    background-color: #2c3e50;
    color: white;
    border-bottom: 2px solid #1a252f;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 15px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

QMenuBar::item:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

QMenu {
    background-color: #2c3e50;
    color: white;
    border: 1px solid #34495e;
    border-radius: 6px;
    padding: 5px;
}

QMenu::item {
    padding: 8px 30px 8px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

QMenu::separator {
    height: 1px;
    background-color: #34495e;
    margin: 5px 10px;
}

/* ===== ПАНЕЛЬ ИНСТРУМЕНТОВ СЛЕВА/СПРАВА ===== */
QDockWidget {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 12px;
    titlebar-close-icon: url(close.png);
    titlebar-normal-icon: url(float.png);
}

QDockWidget::title {
    background-color: #2c3e50;
    color: white;
    padding: 10px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    text-align: center;
    font-weight: 600;
}

/* ===== ГРУППОВЫЕ БОКСЫ ===== */
QGroupBox {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: 600;
    font-size: 13px;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 10px;
    background-color: #2c3e50;
    color: white;
    border-radius: 4px;
}

/* ===== МЕТКИ ===== */
QLabel {
    color: #2c3e50;
    font-size: 12px;
    padding: 2px;
}

QLabel#titleLabel {
    font-size: 16px;
    font-weight: 700;
    color: #2c3e50;
}

QLabel#totalLabel {
    font-size: 14px;
    font-weight: 600;
    color: #2c3e50;
    padding: 10px;
    background-color: #e8f5e9;
    border-radius: 6px;
    border: 1px solid #c8e6c9;
}



QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid #3498db;
    background-color: #f8fdff;
}

QComboBox::drop-down {
    border: none;
    background-color: #2c3e50;
    border-radius: 0 5px 5px 0;
    width: 25px;
}

QComboBox::down-arrow {
    image: url(down_arrow.png);
    width: 12px;
    height: 6px;
}

/* ===== ПОЛОСЫ ПРОКРУТКИ ===== */
QScrollBar:vertical {
    border: none;
    background: #f8f9fa;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #b0bec5;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #78909c;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #f8f9fa;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #b0bec5;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #78909c;
}

/* ===== СПИСОК (QListWidget) ===== */
QListWidget {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 12px;
    padding: 5px;
}

QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #f1f3f5;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #e3f2fd;
    color: #1565c0;
    font-weight: 500;
}

/* ===== ДЕРЕВО (QTreeWidget) ===== */
QTreeWidget {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    font-size: 12px;
}

QTreeWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f1f3f5;
}

QTreeWidget::item:selected {
    background-color: #e3f2fd;
    color: #1565c0;
}

/* ===== ВКЛАДКИ (QTabWidget) ===== */
QTabWidget::pane {
    border: 1px solid #dee2e6;
    border-radius: 8px;
    background-color: white;
    margin-top: 5px;
}

QTabBar::tab {
    background-color: #f8f9fa;
    color: #2c3e50;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #2c3e50;
    color: white;
}

QTabBar::tab:hover:!selected {
    background-color: #e9ecef;
}

/* ===== ПАНЕЛЬ ФИЛЬТРОВ ===== */
QWidget#filterPanel {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 8px;
    padding: 15px;
}

/* ===== СТАТУСНЫЕ ИКОНКИ ===== */
QLabel[status=&quot;success&quot;] {
    color: #27ae60;
    font-weight: 600;
}

QLabel[status=&quot;warning&quot;] {
    color: #f39c12;
    font-weight: 600;
}

QLabel[status=&quot;error&quot;] {
    color: #e74c3c;
    font-weight: 600;
}

/* ===== ФИНАНСОВЫЕ СТИЛИ (для таблицы) ===== */
QTableWidget::item[positive=&quot;true&quot;] {
    color: #27ae60;
    background-color: rgba(39, 174, 96, 0.1);
    font-weight: 600;
}

QTableWidget::item[negative=&quot;true&quot;] {
    color: #e74c3c;
    background-color: rgba(231, 76, 60, 0.1);
    font-weight: 600;
}

QTableWidget::item[zero=&quot;true&quot;] {
    color: #7f8c8d;
    font-style: italic;
}

/* ===== ИКОНКИ ===== */
QToolButton[iconOnly=&quot;true&quot;] {
    border: none;
    background-color: transparent;
    padding: 5px;
    border-radius: 4px;
}

QToolButton[iconOnly=&quot;true&quot;]:hover {
    background-color: rgba(44, 62, 80, 0.1);
}

/* ===== РАЗДЕЛИТЕЛИ ===== */
QFrame#line {
    background-color: #dee2e6;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ===== ДИАЛОГОВЫЕ ОКНА ===== */
QDialog {
    background-color: #f5f7fa;
}

QDialog QLabel {
    color: #2c3e50;
}

QDialog QPushButton {
    min-width: 80px;
}</string>
